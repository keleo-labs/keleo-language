{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$comment": "schemaVersion:1.0.0",
  "title": "Local source catalog snapshot",
  "type": "object",
  "required": ["schemaVersion", "source", "sections"],
  "properties": {
    "schemaVersion": {"const": "1.0.0"},
    "source": {
      "type": "object",
      "required": ["id", "uri", "revision", "inputSha256"],
      "properties": {
        "id": {"type": "string", "minLength": 1},
        "uri": {"type": "string", "minLength": 1},
        "revision": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
        "inputSha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"}
      },
      "additionalProperties": false
    },
    "sections": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["id", "path", "locator", "text"],
        "properties": {
          "id": {"type": "string", "minLength": 1},
          "path": {"type": "array", "minItems": 1, "items": {"type": "string", "minLength": 1}},
          "locator": {"type": "string", "minLength": 1},
          "text": {"type": "string"}
        },
        "additionalProperties": false
      }
    }
  },
  "additionalProperties": false
}
